#!/bin/bash
# Night-shift daemon: runs a claude -p session detached from terminal/REPL,
# auto-resumes after rate-limit waits. Status is written to an on-disk status
# file; no push notifications.
# Usage: night-shift-daemon.sh <prompt-file> <task-slug>
# Designed to be invoked by launchd (see night-shift-*.plist) — survives terminal
# and Claude Code REPL exits, supports 5-hour rate-limit windows via resume.

export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

set -uo pipefail

PROMPT_FILE="${1:?prompt file required}"
TASK_SLUG="${2:?task slug required}"

STATE_DIR="$HOME/reports/night-shift/state"
LOG_DIR="$HOME/reports/night-shift/logs"
REPORT_DIR="$HOME/reports/night-shift"
SESSION_FILE="$STATE_DIR/${TASK_SLUG}.session"
DONE_FILE="$STATE_DIR/${TASK_SLUG}.done"
ATTEMPT_FILE="$STATE_DIR/${TASK_SLUG}.attempts"
STATUS_FILE="$STATE_DIR/${TASK_SLUG}.status"
MAIN_LOG="$LOG_DIR/${TASK_SLUG}-$(date +%Y%m%d-%H%M%S).log"

mkdir -p "$STATE_DIR" "$LOG_DIR"

MAX_RESUMES=5
RESUME_WAIT_SEC=$((5 * 3600 + 5 * 60))  # 5h 5min — rate-limit window + buffer
MAX_BUDGET_USD="${MAX_BUDGET_USD:-8}"

# Single-line human-readable status. Each call overwrites the file, so
# `cat ~/reports/night-shift/state/*.status` shows current state of every task.
# Format: status | round N/M | detail | ts
write_status() {
    local state="$1"
    local detail="${2:-}"
    local round="${ATTEMPTS:-0}/${MAX_RESUMES}"
    local ts="$(date '+%Y-%m-%d %H:%M:%S')"
    if [ -n "$detail" ]; then
        echo "${state} | round ${round} | ${detail} | ${ts}" > "$STATUS_FILE"
    else
        echo "${state} | round ${round} | ${ts}" > "$STATUS_FILE"
    fi
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$MAIN_LOG"
}

is_rate_limited() {
    local output_file="$1"
    grep -qiE "rate limit|usage limit|quota exceeded|too many requests|429|5-hour|5 hour|try again in" "$output_file" 2>/dev/null
}

if [ -f "$SESSION_FILE" ]; then
    SESSION_ID="$(cat "$SESSION_FILE")"
    RESUME_MODE=1
    log "Resuming existing session: $SESSION_ID"
else
    SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    echo "$SESSION_ID" > "$SESSION_FILE"
    RESUME_MODE=0
    log "New session: $SESSION_ID"
fi

ATTEMPTS=0
[ -f "$ATTEMPT_FILE" ] && ATTEMPTS=$(cat "$ATTEMPT_FILE")

log "start task=${TASK_SLUG} session=${SESSION_ID} mode=$([ $RESUME_MODE -eq 1 ] && echo resume || echo fresh) attempt=${ATTEMPTS}/${MAX_RESUMES} log=${MAIN_LOG}"
write_status "starting" "session=${SESSION_ID}"

FRESH_TRIGGER="Execute the research task described in the system prompt. After completing all tasks, execute: touch $DONE_FILE"
RESUME_NUDGE="Continue the unfinished research task from the previous round. If all stages are complete and the report is written under ${REPORT_DIR}/, create the done marker: touch $DONE_FILE"

while :; do
    ATTEMPTS=$((ATTEMPTS + 1))
    echo "$ATTEMPTS" > "$ATTEMPT_FILE"
    ROUND_LOG="$LOG_DIR/${TASK_SLUG}-round${ATTEMPTS}-$(date +%H%M%S).log"
    log "=== Attempt $ATTEMPTS/$MAX_RESUMES → $ROUND_LOG ==="
    write_status "running" "log=${ROUND_LOG##*/}"

    if [ $RESUME_MODE -eq 0 ]; then
        # First run — use --system-prompt-file so the full prompt goes via a file,
        # avoiding ARG_MAX limits and multiline positional-argument issues
        claude -p \
            --session-id "$SESSION_ID" \
            --system-prompt-file "$PROMPT_FILE" \
            --permission-mode bypassPermissions \
            --max-budget-usd "$MAX_BUDGET_USD" \
            --disallowedTools="Bash(rm -rf*)" \
            --disallowedTools="Bash(git push*)" \
            "$FRESH_TRIGGER" \
            > "$ROUND_LOG" 2>&1
        EXIT=$?
        RESUME_MODE=1
    else
        claude -p \
            --resume "$SESSION_ID" \
            --permission-mode bypassPermissions \
            --max-budget-usd "$MAX_BUDGET_USD" \
            --disallowedTools="Bash(rm -rf*)" \
            --disallowedTools="Bash(git push*)" \
            "$RESUME_NUDGE" \
            > "$ROUND_LOG" 2>&1
        EXIT=$?
    fi

    log "Round $ATTEMPTS exit=$EXIT"

    if [ -f "$DONE_FILE" ]; then
        REPORT_PATH="${REPORT_DIR}/${TASK_SLUG}-$(date +%Y-%m-%d).md"
        log "done task=${TASK_SLUG} attempts=${ATTEMPTS} report=${REPORT_PATH}"
        write_status "done" "report=${REPORT_PATH##*/}"
        exit 0
    fi

    if [ $EXIT -ne 0 ]; then
        if is_rate_limited "$ROUND_LOG"; then
            if [ $ATTEMPTS -ge $MAX_RESUMES ]; then
                log "failed: max resume attempts reached task=${TASK_SLUG} attempts=${ATTEMPTS} last=${ROUND_LOG}"
                write_status "failed" "max-resumes reached; see ${ROUND_LOG##*/}"
                exit 1
            fi
            WAIT_UNTIL=$(date -v +$((RESUME_WAIT_SEC))S '+%H:%M' 2>/dev/null || date -d "+${RESUME_WAIT_SEC} seconds" '+%H:%M')
            log "rate-limited, pausing task=${TASK_SLUG} attempt=${ATTEMPTS} resume-at=${WAIT_UNTIL}"
            write_status "paused" "rate-limited, resume at ${WAIT_UNTIL}"
            sleep "$RESUME_WAIT_SEC"
            continue
        else
            log "failed: non-rate-limit error task=${TASK_SLUG} exit=${EXIT} log=${ROUND_LOG} tail=$(tail -20 "$ROUND_LOG" | tr '\n' ' ' | cut -c1-300)"
            write_status "failed" "non-rate-limit exit=${EXIT}; see ${ROUND_LOG##*/}"
            exit $EXIT
        fi
    fi

    # Exit 0 but no done marker
    if [ $ATTEMPTS -ge $MAX_RESUMES ]; then
        log "ambiguous: claude exit 0 but no done marker after ${ATTEMPTS} rounds log=${ROUND_LOG}"
        write_status "ambiguous" "exit 0 no done marker after ${ATTEMPTS} rounds; see ${ROUND_LOG##*/}"
        exit 2
    fi
    log "Exit 0 but no done marker — nudging resume"
    sleep 5
done
